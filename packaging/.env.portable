MODEL_PATH=model/best.pt

CAMERA_SOURCE=0
CAMERA_BACKEND=
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAMERA_FPS=30
CAMERA_RECONNECT_SECONDS=2
RTSP_TRANSPORT=tcp

JPEG_QUALITY=80
STREAM_FPS=20

DETECTION_CONFIDENCE=0.25
INFERENCE_CONFIDENCE=0.65
INFERENCE_FPS=5
REQUIRED_STABLE_FRAMES=3
DECIMAL_PLACES=2
SNAPSHOT_MAX_AGE_SECONDS=3
DISPLAY_COLORS=red
DISPLAY_MAX_CANDIDATES=5
DISPLAY_IMAGE_SIZE=960
DETECTION_DEBUG=false

STORAGE_ENABLE=true
STORAGE_TYPE=csv
CSV_PATH=data/measurements.csv
DATABASE_PATH=data/measurements.db
DUPLICATE_WINDOW_SECONDS=60

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
